#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { vec4 v[]; } inp;
layout(std430, binding = 1) writeonly buffer Out { float o[]; } outp;

void main() {
  uint i = gl_GlobalInvocationID.x;
  vec4 x = inp.v[i];
  float a = x.x, b = x.y, c = x.z, d = x.w;
  outp.o[i * 8 + 0] = a / b;
  outp.o[i * 8 + 1] = fma(a, b, c);
  outp.o[i * 8 + 2] = log(d);
  outp.o[i * 8 + 3] = log2(d);
  outp.o[i * 8 + 4] = sin(a);
  outp.o[i * 8 + 5] = cos(a);
  outp.o[i * 8 + 6] = 1.0 / b;
  outp.o[i * 8 + 7] = a * b + c;
}
