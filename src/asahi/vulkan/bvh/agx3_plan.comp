/* Copyright 2026 Aurora Silicon
 * SPDX-License-Identifier: MIT
 *
 * Convert a common binary BVH into independent native-node encoding jobs.
 * Collapse up to three binary levels into each wide inner node; stop early
 * at subtrees containing at most eight triangle records. Those subtrees
 * become one leaf cluster. A record holds one triangle, or two sibling
 * triangles that share an edge (phase 0 marks their parent as a pair).
 * Preserve the common builder's spatial partition and order. Built twice:
 * HK_AGX3_PLAN_PAIRS forms pairs (see hk_agx3_plan_args.pairs).
 * A global atomic allocator compacts jobs/child regions; it never changes
 * traversal order. The five phases are separated by dispatch barriers.
 * An update does not plan: it encodes from the retained jobs (see
 * hk_agx3_retained_job).
 */
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#include "hk_build_interface.h"

#ifdef HK_AGX3_PLAN_FUSED_PAIRS
#define HK_AGX3_PLAN_FUSED 1
#define HK_AGX3_PLAN_PAIRS 1
#endif

#ifdef HK_AGX3_PLAN_FUSED
layout(local_size_x = HK_AGX3_PLAN_FUSED_GROUP_SIZE) in;
#else
layout(local_size_x = 64) in;
#endif
layout(push_constant) uniform CONSTS
{
   hk_agx3_plan_args args;
};

#ifdef HK_AGX3_PLAN_FUSED
/* Single-workgroup shared scratch for small builds (node_bound <=
 * HK_AGX3_PLAN_FUSED_MAX_NODES). Lifetimes across phases are disjoint:
 *   s_parent:     written in phase 0 & 1 (atomicCompSwap), read in phase 2.
 *   s_leaf_count: written in phase 0 & 1 (by owner id), read in phase 2 & 3.
 *   s_job:        bits 16..17 hold pair flags written in phase 0 (read-only
 *                 after); bits 0..15 hold job id written in phase 2 by owner
 *                 id (0xffffu = none) and read in phase 3.
 */
shared uint s_parent[HK_AGX3_PLAN_FUSED_MAX_NODES];
shared uint s_leaf_count[HK_AGX3_PLAN_FUSED_MAX_NODES];
shared uint s_job[HK_AGX3_PLAN_FUSED_MAX_NODES];
shared uint16_t s_child0[HK_AGX3_PLAN_FUSED_MAX_NODES];
shared uint16_t s_child1[HK_AGX3_PLAN_FUSED_MAX_NODES];
shared uint s_root_slot[HK_AGX3_PLAN_FUSED_MAX_NODES];
shared uint s_job_count;
shared uint s_next_slot;
shared uint s_depth;
shared uint s_error;
#define HK_AGX3_FUSED_NO_JOB 0xffffu
#define HK_AGX3_FUSED_NO_CHILD uint16_t(0xffffu)
#define HK_AGX3_FUSED_PAIR 0x10000u
#define HK_AGX3_FUSED_PAIR_OPAQUE 0x20000u
#endif

/* The common builder's internal node count, final before planning starts:
 * main() reads it once rather than every source_index() reloading it past
 * this invocation's own stores and atomics. */
uint internal_count;

void
fail(uint flag)
{
#ifdef HK_AGX3_PLAN_FUSED
   atomicOr(s_error, flag);
#else
   atomicOr(DEREF(args.state).error, flag);
#endif
}


uint
leaf_size()
{
   return args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
             ? SIZEOF(vk_ir_instance_node)
             : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                ? SIZEOF(vk_ir_aabb_node) : SIZEOF(vk_ir_triangle_node);
}

uint
source_index(uint ir_id)
{
   if (ir_id == VK_BVH_INVALID_NODE)
      return 0xffffffffu;
   uint offset = ir_id_to_offset(ir_id), kind = ir_id_to_type(ir_id);
   if (offset < args.root_offset) {
      if (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR) {
         if (kind == vk_ir_node_instance) {
            uint i = offset / SIZEOF(vk_ir_instance_node);
            if (i * SIZEOF(vk_ir_instance_node) == offset && i < args.leaf_bound)
               return i;
         }
      } else if (args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR) {
         if (kind == vk_ir_node_aabb) {
            uint i = offset / SIZEOF(vk_ir_aabb_node);
            if (i * SIZEOF(vk_ir_aabb_node) == offset && i < args.leaf_bound)
               return i;
         }
      } else if (kind == vk_ir_node_triangle) {
         uint i = offset / SIZEOF(vk_ir_triangle_node);
         if (i * SIZEOF(vk_ir_triangle_node) == offset && i < args.leaf_bound)
            return i;
      }
   } else if (kind == vk_ir_node_internal) {
      uint rel = offset - args.root_offset;
      uint i = rel / SIZEOF(vk_ir_box_node);
      if (i * SIZEOF(vk_ir_box_node) == rel &&
          i < internal_count &&
          i < args.node_bound - args.leaf_bound)
         return args.leaf_bound + i;
   }
   fail(HK_AGX3_PLAN_INDEX);
   return 0xffffffffu;
}

uint
source_offset(uint index)
{
   return index < args.leaf_bound
             ? index * leaf_size()
             : args.root_offset +
                  (index - args.leaf_bound) * SIZEOF(vk_ir_box_node);
}

uint
root_index()
{
   return args.leaf_bound + internal_count - 1;
}

uvec2
children(uint index)
{
   REF(vk_ir_box_node)
   node =
      REF(vk_ir_box_node)(OFFSET(args.intermediate_bvh, source_offset(index)));
   return uvec2(DEREF(node).children[0], DEREF(node).children[1]);
}

#ifdef HK_AGX3_PLAN_PAIRS
/* Triangle leaf index of an IR child reference, or ~0u. Unlike
 * source_index() this never records an error, so phase 0 may use it before
 * the plan state exists. */
uint
triangle_index(uint ir_id)
{
   if (ir_id == VK_BVH_INVALID_NODE || ir_id_to_type(ir_id) != vk_ir_node_triangle)
      return ~0u;
   uint offset = ir_id_to_offset(ir_id);
   if (offset >= args.root_offset || offset % SIZEOF(vk_ir_triangle_node) != 0)
      return ~0u;
   uint i = offset / SIZEOF(vk_ir_triangle_node);
   return i < args.leaf_bound ? i : ~0u;
}

/* Pair flags (HK_AGX3_PLAN_PAIR...) for internal node `index`: set when its
 * children are two triangles of one geometry and opacity sharing an edge,
 * which then make up one native record. */
uint
pair_flags(uint index)
{
   if (index < args.leaf_bound ||
       index - args.leaf_bound >= internal_count)
      return 0u;
   uvec2 pair = children(index);
   uint t0 = triangle_index(pair[0]), t1 = triangle_index(pair[1]);
   if (t0 == ~0u || t1 == ~0u)
      return 0u;
   REF(vk_ir_triangle_node) a = REF(vk_ir_triangle_node)(
      OFFSET(args.intermediate_bvh, source_offset(t0)));
   REF(vk_ir_triangle_node) b = REF(vk_ir_triangle_node)(
      OFFSET(args.intermediate_bvh, source_offset(t1)));
   uint flags = DEREF(a).geometry_id_and_flags;
   if (flags != DEREF(b).geometry_id_and_flags)
      return 0u;
   vec3 va[3], vb[3];
   for (uint v = 0; v < 3; ++v)
      for (uint c = 0; c < 3; ++c) {
         va[v][c] = DEREF(a).coords[v][c];
         vb[v][c] = DEREF(b).coords[v][c];
      }
   if (hk_agx3_shared_edge(va, vb) == ~0u)
      return 0u;
   return HK_AGX3_PLAN_PAIR |
          ((flags & VK_GEOMETRY_OPAQUE) != 0 ? HK_AGX3_PLAN_PAIR_OPAQUE : 0u);
}

bool
is_pair(uint index)
{
#ifdef HK_AGX3_PLAN_FUSED
   return index >= args.leaf_bound &&
          (s_job[index] & HK_AGX3_FUSED_PAIR) != 0u;
#else
   return index >= args.leaf_bound &&
          (DEREF(INDEX(hk_agx3_plan_node, args.nodes, index)).depth &
           HK_AGX3_PLAN_PAIR) != 0u;
#endif
}
#endif

/* Every non-empty pending subtree contributes at least one leaf. Stop at
 * nine before pushing past this bounded stack, even for a skewed tree. A
 * triangle pair counts as one leaf. */
uint
count_leaves(uint start)
{
   uint stack[9], sp = 1, count = 0, steps = 0;
   uint opacity = 0;
   bool have_opacity = false;
   stack[0] = start;
   while (sp != 0) {
      if (++steps > args.node_bound * 2u) {
         fail(HK_AGX3_PLAN_CYCLE);
         return 0;
      }
      uint index = stack[--sp];
#ifdef HK_AGX3_PLAN_PAIRS
#ifdef HK_AGX3_PLAN_FUSED
      uint flags = index < args.leaf_bound ? 0u : s_job[index];
      if (index < args.leaf_bound || (flags & HK_AGX3_FUSED_PAIR) != 0u) {
#else
      uint flags = index < args.leaf_bound ? 0u
         : DEREF(INDEX(hk_agx3_plan_node, args.nodes, index)).depth;
      if (index < args.leaf_bound || (flags & HK_AGX3_PLAN_PAIR) != 0u) {
#endif
         if (args.geometry_type == VK_GEOMETRY_TYPE_TRIANGLES_KHR) {
            uint current_opacity;
            if (index < args.leaf_bound) {
               REF(vk_ir_triangle_node) triangle = REF(vk_ir_triangle_node)(
                  OFFSET(args.intermediate_bvh, source_offset(index)));
               current_opacity = DEREF(triangle).geometry_id_and_flags &
                                 VK_GEOMETRY_OPAQUE;
            } else {
#ifdef HK_AGX3_PLAN_FUSED
               current_opacity = (flags & HK_AGX3_FUSED_PAIR_OPAQUE) != 0u
                                    ? VK_GEOMETRY_OPAQUE : 0u;
#else
               current_opacity = (flags & HK_AGX3_PLAN_PAIR_OPAQUE) != 0u
                                    ? VK_GEOMETRY_OPAQUE : 0u;
#endif
            }
#else
      if (index < args.leaf_bound) {
         if (args.geometry_type == VK_GEOMETRY_TYPE_TRIANGLES_KHR) {
            REF(vk_ir_triangle_node) triangle = REF(vk_ir_triangle_node)(
               OFFSET(args.intermediate_bvh, source_offset(index)));
            uint current_opacity = DEREF(triangle).geometry_id_and_flags &
                                   VK_GEOMETRY_OPAQUE;
#endif
            /* One native leaf cluster shares its child triangle type.
             * A mixed-opacity subtree must remain an inner node; retain
             * normal spatial collapse for every homogeneous subtree. */
            if (have_opacity && opacity != current_opacity)
               return 9;
            opacity = current_opacity;
            have_opacity = true;
         }
         ++count;
      } else {
#ifdef HK_AGX3_PLAN_FUSED
         uint c0 = uint(s_child0[index]);
         uint c1 = uint(s_child1[index]);
         if (c0 != uint(HK_AGX3_FUSED_NO_CHILD)) {
            if (sp == 9)
               return 9;
            stack[sp++] = c0;
         }
         if (c1 != uint(HK_AGX3_FUSED_NO_CHILD)) {
            if (sp == 9)
               return 9;
            stack[sp++] = c1;
         }
#else
         uvec2 pair = children(index);
         for (uint c = 0; c < 2; c++)
            if (pair[c] != VK_BVH_INVALID_NODE) {
               uint child = source_index(pair[c]);
               if (child == 0xffffffffu)
                  return 0;
               if (sp == 9)
                  return 9;
               stack[sp++] = child;
            }
#endif
      }
      if (count + sp > 8)
         return 9;
   }
   return count;
}

#ifdef HK_AGX3_PLAN_FUSED
void
initialize_fused(uint tid)
{
   uint bound = min(args.node_bound, HK_AGX3_PLAN_FUSED_MAX_NODES);
   for (uint id = tid; id < bound; id += HK_AGX3_PLAN_FUSED_GROUP_SIZE) {
      s_parent[id] = 0xffffffffu;
      uint lc = id < args.leaf_bound ? 1u : 0u;
      uint jw = HK_AGX3_FUSED_NO_JOB;
#ifdef HK_AGX3_PLAN_PAIRS
      uint pf = pair_flags(id);
      if (pf != 0u) {
         lc = 1u;
         jw |= HK_AGX3_FUSED_PAIR |
               ((pf & HK_AGX3_PLAN_PAIR_OPAQUE) != 0u ? HK_AGX3_FUSED_PAIR_OPAQUE : 0u);
      }
#endif
      s_leaf_count[id] = lc;
      s_job[id] = jw;
   }
   if (tid == 0u) {
      s_job_count = 0u;
      s_next_slot = 3u;
      s_depth = 0u;
      uint err = 0u;
      if (DEREF(args.header).active_leaf_count == 0)
         err = HK_AGX3_PLAN_EMPTY;
      if (args.node_bound > HK_AGX3_PLAN_FUSED_MAX_NODES ||
          args.leaf_bound > args.node_bound || args.node_bound > 0xffffffffu / 64u ||
          (DEREF(args.header).active_leaf_count != 0 &&
           (DEREF(args.header).ir_internal_node_count == 0 ||
            DEREF(args.header).ir_internal_node_count >
               args.node_bound - args.leaf_bound)) ||
          DEREF(args.header).active_leaf_count > args.leaf_bound ||
          args.root_offset != args.leaf_bound * leaf_size() ||
          args.output_bvh == 0 || (args.output_bvh & 63ul) != 0 ||
          args.output_bvh >= (1ul << 48) ||
          uint64_t(args.slot_bound) * 64ul + 184ul > (1ul << 48) - args.output_bvh ||
          args.slot_bound < 5)
         err |= HK_AGX3_PLAN_INDEX;
      s_error = err;
   }
}

void
link_fused(uint id)
{
   uvec2 pair = children(id);
   uint16_t resolved[2] = uint16_t[2](HK_AGX3_FUSED_NO_CHILD, HK_AGX3_FUSED_NO_CHILD);
   for (uint c = 0; c < 2; c++)
      if (pair[c] != VK_BVH_INVALID_NODE) {
         uint child = source_index(pair[c]);
         if (child == 0xffffffffu)
            return;
         resolved[c] = uint16_t(child);
         uint old = atomicCompSwap(s_parent[child], 0xffffffffu, id);
         if (old != 0xffffffffu)
            fail(HK_AGX3_PLAN_SHAPE);
      }
   s_child0[id] = resolved[0];
   s_child1[id] = resolved[1];
}

void
count_fused(uint id)
{
#ifdef HK_AGX3_PLAN_PAIRS
   if (!is_pair(id))
#endif
      s_leaf_count[id] = count_leaves(id);
}

void
classify_fused(uint id)
{
   uint parent = s_parent[id];
   uint leaf_count = s_leaf_count[id];
   uint root = root_index();
   bool allow_update = (args.build_flags & 1u) != 0u;
   if (id != root && parent == 0xffffffffu) {
      if (allow_update)
         DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).job = 0xffffffffu;
      return; /* inactive IR leaf */
   }
   if (id != root && leaf_count <= 8u && s_leaf_count[parent] <= 8u) {
      if (allow_update)
         DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).job = 0xffffffffu;
      return;
   }
   uint cursor = id, depth = 0;
   while (cursor != root) {
      if (depth++ >= args.node_bound) {
         fail(HK_AGX3_PLAN_CYCLE);
         return;
      }
      cursor = s_parent[cursor];
      if (cursor >= args.node_bound) {
         fail(HK_AGX3_PLAN_INDEX);
         return;
      }
   }
   bool selected = id == root || leaf_count <= 8u || depth % 3u == 0u;
   if (!selected) {
      if (allow_update) {
         DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).depth = depth;
         DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).job = 0xffffffffu;
      }
      return;
   }
   uint job = atomicAdd(s_job_count, 1u);
   if (job >= args.node_bound) {
      fail(HK_AGX3_PLAN_ALLOCATION);
      return;
   }
   s_job[id] = (s_job[id] & ~HK_AGX3_FUSED_NO_JOB) | job;
   s_root_slot[job] = id == root ? 0u : 0xffffffffu;
   if (allow_update) {
#ifdef HK_AGX3_PLAN_PAIRS
      uint pf = s_job[id];
      uint out_depth = depth |
         ((pf & HK_AGX3_FUSED_PAIR) != 0u ? HK_AGX3_PLAN_PAIR : 0u) |
         ((pf & HK_AGX3_FUSED_PAIR_OPAQUE) != 0u ? HK_AGX3_PLAN_PAIR_OPAQUE : 0u);
      DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).depth = out_depth;
#else
      DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).depth = depth;
#endif
      DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).job = job;
   }
   atomicMax(s_depth, (depth + 2u) / 3u + 1u);
}

void
emit_fused(uint id)
{
   uint my_job = s_job[id] & HK_AGX3_FUSED_NO_JOB;
   if (my_job == HK_AGX3_FUSED_NO_JOB)
      return;
   uint leaf_count = s_leaf_count[id];
   bool leaf = leaf_count <= 8u;
   uint stack[9], level[9], selected[8], sp = 1, count = 0, steps = 0;
   stack[0] = id;
   level[0] = 0;
   while (sp != 0) {
      if (++steps > args.node_bound * 2u) {
         fail(HK_AGX3_PLAN_CYCLE);
         return;
      }
      uint current = stack[--sp], d = level[sp];
#ifdef HK_AGX3_PLAN_PAIRS
      bool end = leaf ? current < args.leaf_bound || is_pair(current)
                      : current != id &&
#else
      bool end = leaf ? current < args.leaf_bound
                      : current != id &&
#endif
                           (s_leaf_count[current] <= 8u || d == 3u);
      if (end) {
         if (count == 8) {
            fail(HK_AGX3_PLAN_SHAPE);
            return;
         }
         selected[count++] = current;
      } else {
         /* Stack is LIFO; visit the common builder's left child first. */
         uint c1 = uint(s_child1[current]);
         uint c0 = uint(s_child0[current]);
         if (c1 != uint(HK_AGX3_FUSED_NO_CHILD)) {
            if (sp == 9) {
               fail(HK_AGX3_PLAN_SHAPE);
               return;
            }
            stack[sp] = c1;
            level[sp++] = d + 1;
         }
         if (c0 != uint(HK_AGX3_FUSED_NO_CHILD)) {
            if (sp == 9) {
               fail(HK_AGX3_PLAN_SHAPE);
               return;
            }
            stack[sp] = c0;
            level[sp++] = d + 1;
         }
      }
   }
   if (count == 0 || (leaf && count != leaf_count)) {
      fail(HK_AGX3_PLAN_SHAPE);
      return;
   }
   uint slots = leaf ? (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
                           ? 2u * count
                           : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                              ? count : count + (count + 3u) / 4u) : count;
   uint first = atomicAdd(s_next_slot, slots);
   if (slots > args.slot_bound || first > args.slot_bound - slots) {
      fail(HK_AGX3_PLAN_ALLOCATION);
      return;
   }
   REF(hk_agx3_leaf_job) job = INDEX(hk_agx3_leaf_job, args.jobs, my_job);
   DEREF(job).intermediate_bvh = args.intermediate_bvh;
   DEREF(job).output_bvh = args.output_bvh;
   DEREF(job).child_slot = first;
   DEREF(job).child_count = count;
   DEREF(job).node_kind =
      leaf
         ? (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
               ? HK_AGX3_NODE_INSTANCES
               : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                  ? HK_AGX3_NODE_AABBS : HK_AGX3_NODE_LEAF)
         : HK_AGX3_NODE_INNER;
   for (uint c = 0; c < count; c++) {
#ifdef HK_AGX3_PLAN_PAIRS
      DEREF(job).triangle_offsets[c] =
         source_offset(selected[c]) |
         (leaf && selected[c] >= args.leaf_bound ? HK_AGX3_LEAF_PAIR_OFFSET : 0u);
#else
      DEREF(job).triangle_offsets[c] = source_offset(selected[c]);
#endif
      if (!leaf) {
         uint child_job = s_job[selected[c]] & HK_AGX3_FUSED_NO_JOB;
         if (child_job >= s_job_count) {
            fail(HK_AGX3_PLAN_SHAPE);
            return;
         }
         s_root_slot[child_job] = first + c;
      }
   }
   for (uint c = count; c < 8u; c++)
      DEREF(job).triangle_offsets[c] = 0u;
}

void
finish_fused(uint tid)
{
   uint err = s_error;
   uint next_slot = s_next_slot;
   uint raw_jobs = s_job_count;
   if (err == 0u) {
      for (uint j = tid; j < raw_jobs; j += HK_AGX3_PLAN_FUSED_GROUP_SIZE)
         DEREF(INDEX(hk_agx3_leaf_job, args.jobs, j)).root_slot = s_root_slot[j];
   }
   /* Clear the TLAS instance pointer table cooperatively in the same dispatch
    * so the envelope shader can run with refit=1 and skip the clear pass. */
   if (err == 0u &&
       args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR &&
       next_slot >= 3u) {
      uint64_t pointers =
         uint64_t(next_slot) * 64ul + uint64_t(args.leaf_bound) * 64ul;
      uint64_t size = pointers + uint64_t(args.leaf_bound) * 16ul + 184ul;
      if (size <= (1ul << 48) - args.output_bvh) {
         for (uint i = tid; i < args.leaf_bound; i += HK_AGX3_PLAN_FUSED_GROUP_SIZE)
            DEREF(REF(uvec4)(args.output_bvh + pointers + uint64_t(i) * 16ul)) =
               uvec4(0u);
      }
   }
   if (tid != 0u)
      return;
   uint jobs = err != 0u ? 0u : raw_jobs;
   hk_agx3_plan_state state;
   state.job_count = jobs;
   state.groups_y = 1u;
   state.groups_z = 1u;
   state.next_slot = next_slot;
   state.depth = s_depth;
   state.error = err;
   state.saved_offsets = 0u;
   state.saved_positions = 0u;
   DEREF(args.state) = state;

   hk_agx3_envelope_job job;
   uint root = err == 0u ? root_index() : 0u;
   job.bounds =
      REF(vk_ir_node)(OFFSET(args.intermediate_bvh, source_offset(root)));
   job.output_bvh = args.output_bvh;
   job.end_slot = next_slot;
   job.primitive_count =
      err == 0u ? DEREF(args.header).active_leaf_count : 0u;
   job.node_count = raw_jobs;
   job.depth = s_depth;
   job.opaque_build_word = err == HK_AGX3_PLAN_EMPTY ? HK_AGX3_PLAN_EMPTY : 0u;
   job.resource_id = args.resource_id;
   job.geometry_type = args.geometry_type;
   job.leaf_bound = args.leaf_bound;
   DEREF(args.envelope) = job;

   uint64_t dispatch = uint64_t(args.state) + uint64_t(HK_AGX3_PLAN_ENCODE_DISPATCH);
   DEREF(REF(uint32_t)(dispatch)) =
      (jobs + HK_AGX3_NODE_JOBS_PER_GROUP - 1u) / HK_AGX3_NODE_JOBS_PER_GROUP;
   DEREF(REF(uint32_t)(dispatch + 4ul)) = 1u;
   DEREF(REF(uint32_t)(dispatch + 8ul)) = 1u;
}

void
main()
{
   uint tid = gl_LocalInvocationID.x;
   internal_count = DEREF(args.header).ir_internal_node_count;

   initialize_fused(tid);
   memoryBarrierShared();
   barrier();

   if (s_error == 0u) {
      uint end_internal = args.leaf_bound + internal_count;
      for (uint id = args.leaf_bound + tid; id < end_internal;
           id += HK_AGX3_PLAN_FUSED_GROUP_SIZE)
         link_fused(id);
      memoryBarrierShared();
      barrier();
   }

   if (s_error == 0u) {
      uint end_internal = args.leaf_bound + internal_count;
      for (uint id = args.leaf_bound + tid; id < end_internal;
           id += HK_AGX3_PLAN_FUSED_GROUP_SIZE)
         count_fused(id);
      memoryBarrierShared();
      barrier();
   }

   if (s_error == 0u) {
      for (uint id = tid; id < args.node_bound;
           id += HK_AGX3_PLAN_FUSED_GROUP_SIZE)
         classify_fused(id);
      memoryBarrierShared();
      barrier();
   }

   if (s_error == 0u) {
      for (uint id = tid; id < args.node_bound;
           id += HK_AGX3_PLAN_FUSED_GROUP_SIZE)
         emit_fused(id);
      memoryBarrierShared();
      barrier();
   }

   finish_fused(tid);
}
#else
void
initialize(uint id)
{
   if (id < args.node_bound) {
      hk_agx3_plan_node node;
      node.parent = 0xffffffffu;
      node.leaf_count = id < args.leaf_bound ? 1u : 0u;
#ifdef HK_AGX3_PLAN_PAIRS
      node.depth = pair_flags(id);
      node.job = 0xffffffffu;
      if (node.depth != 0u)
         node.leaf_count = 1;
#else
      node.depth = 0;
      node.job = 0xffffffffu;
#endif
      DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)) = node;
   }
   if (id == 0) {
      hk_agx3_plan_state state;
      state.job_count = 0;
      state.groups_y = 1;
      state.groups_z = 1;
      state.next_slot = 3;
      state.depth = 0;
      state.error = 0;
      state.saved_offsets = 0;
      state.saved_positions = 0;
      if (DEREF(args.header).active_leaf_count == 0)
         state.error = HK_AGX3_PLAN_EMPTY;
      if (args.leaf_bound > args.node_bound || args.node_bound > 0xffffffffu / 64u ||
          (DEREF(args.header).active_leaf_count != 0 &&
           (DEREF(args.header).ir_internal_node_count == 0 ||
            DEREF(args.header).ir_internal_node_count >
               args.node_bound - args.leaf_bound)) ||
          DEREF(args.header).active_leaf_count > args.leaf_bound ||
          args.root_offset != args.leaf_bound * leaf_size() ||
          args.output_bvh == 0 || (args.output_bvh & 63ul) != 0 ||
          args.output_bvh >= (1ul << 48) ||
          uint64_t(args.slot_bound) * 64ul + 184ul > (1ul << 48) - args.output_bvh ||
          args.slot_bound < 5)
         state.error |= HK_AGX3_PLAN_INDEX;
      DEREF(args.state) = state;
   }
}

void
link_and_count(uint id)
{
   if (id < args.leaf_bound ||
       id >= args.leaf_bound + internal_count)
      return;
   uvec2 pair = children(id);
   for (uint c = 0; c < 2; c++)
      if (pair[c] != VK_BVH_INVALID_NODE) {
         uint child = source_index(pair[c]);
         if (child == 0xffffffffu)
            return;
         uint old = atomicCompSwap(
            DEREF(INDEX(hk_agx3_plan_node, args.nodes, child)).parent,
            0xffffffffu, id);
         if (old != 0xffffffffu)
            fail(HK_AGX3_PLAN_SHAPE);
      }
#ifdef HK_AGX3_PLAN_PAIRS
   if (!is_pair(id))
#endif
      DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).leaf_count =
         count_leaves(id);
}

void
classify(uint id)
{
   uint root = root_index();
   bool selected = false;
   uint depth = 0u;
   hk_agx3_plan_node node;
   if (id < args.node_bound) {
      node = DEREF(INDEX(hk_agx3_plan_node, args.nodes, id));
      bool active_node = (id == root) || (node.parent != 0xffffffffu);
      if (active_node && id != root && node.leaf_count <= 8u &&
          DEREF(INDEX(hk_agx3_plan_node, args.nodes, node.parent)).leaf_count <= 8u)
         active_node = false;
      if (active_node) {
         uint cursor = id;
         while (cursor != root) {
            if (depth++ >= args.node_bound) {
               fail(HK_AGX3_PLAN_CYCLE);
               active_node = false;
               break;
            }
            cursor = DEREF(INDEX(hk_agx3_plan_node, args.nodes, cursor)).parent;
            if (cursor >= args.node_bound) {
               fail(HK_AGX3_PLAN_INDEX);
               active_node = false;
               break;
            }
         }
      }
      if (active_node) {
#ifdef HK_AGX3_PLAN_PAIRS
         DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).depth =
            depth | (node.depth & (HK_AGX3_PLAN_PAIR | HK_AGX3_PLAN_PAIR_OPAQUE));
#else
         DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).depth = depth;
#endif
         selected = id == root || node.leaf_count <= 8u || depth % 3u == 0u;
      }
   }
   uvec4 sel_ballot = subgroupBallot(selected);
   uint sel_count = subgroupBallotBitCount(sel_ballot);
   uint job_base = 0u;
   if (sel_count != 0u) {
      if (subgroupElect())
         job_base = atomicAdd(DEREF(args.state).job_count, sel_count);
      job_base = subgroupBroadcastFirst(job_base);
   }
   uint max_d = subgroupMax(selected ? (depth + 2u) / 3u + 1u : 0u);
   if (subgroupElect() && max_d != 0u)
      atomicMax(DEREF(args.state).depth, max_d);
   if (!selected)
      return;
   uint job = job_base + subgroupBallotExclusiveBitCount(sel_ballot);
   if (job >= args.node_bound) {
      fail(HK_AGX3_PLAN_ALLOCATION);
      return;
   }
   DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).job = job;
   hk_agx3_leaf_job output_job;
   output_job.intermediate_bvh = args.intermediate_bvh;
   output_job.output_bvh = args.output_bvh;
   output_job.root_slot = id == root ? 0u : 0xffffffffu;
   output_job.child_slot = 0;
   output_job.child_count = 0;
   output_job.node_kind =
      node.leaf_count <= 8
         ? (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
               ? HK_AGX3_NODE_INSTANCES
               : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                  ? HK_AGX3_NODE_AABBS : HK_AGX3_NODE_LEAF)
         : HK_AGX3_NODE_INNER;
   for (uint i = 0; i < 8; i++)
      output_job.triangle_offsets[i] = 0;
   DEREF(INDEX(hk_agx3_leaf_job, args.jobs, job)) = output_job;
   atomicMax(DEREF(args.state).depth, (depth + 2u) / 3u + 1u);
}

void
emit(uint id)
{
   bool active_emit = false;
   bool leaf = false;
   uint selected[8];
   uint count = 0u;
   uint slots = 0u;
   hk_agx3_plan_node node;
   if (id < args.node_bound) {
      node = DEREF(INDEX(hk_agx3_plan_node, args.nodes, id));
      if (node.job != 0xffffffffu) {
         leaf = node.leaf_count <= 8;
         uint stack[9], level[9], sp = 1, steps = 0;
         stack[0] = id;
         level[0] = 0;
         bool ok = true;
         while (sp != 0) {
            if (++steps > args.node_bound * 2u) {
               fail(HK_AGX3_PLAN_CYCLE);
               ok = false;
               break;
            }
            uint current = stack[--sp], d = level[sp];
#ifdef HK_AGX3_PLAN_PAIRS
            bool end = leaf ? current < args.leaf_bound || is_pair(current)
                            : current != id &&
#else
            bool end = leaf ? current < args.leaf_bound
                            : current != id &&
#endif
                                 (DEREF(INDEX(hk_agx3_plan_node, args.nodes, current))
                                        .leaf_count <= 8 ||
                                  d == 3);
            if (end) {
               if (count == 8) {
                  fail(HK_AGX3_PLAN_SHAPE);
                  ok = false;
                  break;
               }
               selected[count++] = current;
            } else {
               uvec2 pair = children(current);
               /* Stack is LIFO; visit the common builder's left child first. */
               for (int c = 1; c >= 0; c--)
                  if (pair[c] != VK_BVH_INVALID_NODE) {
                     uint child = source_index(pair[c]);
                     if (child == 0xffffffffu || sp == 9) {
                        fail(HK_AGX3_PLAN_SHAPE);
                        ok = false;
                        break;
                     }
                     stack[sp] = child;
                     level[sp++] = d + 1;
                  }
               if (!ok)
                  break;
            }
         }
         if (ok) {
            if (count == 0 || (leaf && count != node.leaf_count)) {
               fail(HK_AGX3_PLAN_SHAPE);
            } else {
               slots = leaf ? (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
                                  ? 2u * count
                                  : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                                     ? count : count + (count + 3u) / 4u) : count;
               active_emit = true;
            }
         }
      }
   }
   uint total_slots = subgroupAdd(slots);
   uint slot_base = 0u;
   if (total_slots != 0u) {
      if (subgroupElect())
         slot_base = atomicAdd(DEREF(args.state).next_slot, total_slots);
      slot_base = subgroupBroadcastFirst(slot_base);
   }
   uint first = slot_base + subgroupExclusiveAdd(slots);
   if (!active_emit)
      return;
   if (slots > args.slot_bound || first > args.slot_bound - slots) {
      fail(HK_AGX3_PLAN_ALLOCATION);
      return;
   }
   REF(hk_agx3_leaf_job) job = INDEX(hk_agx3_leaf_job, args.jobs, node.job);
   DEREF(job).child_slot = first;
   DEREF(job).child_count = count;
   for (uint c = 0; c < count; c++) {
#ifdef HK_AGX3_PLAN_PAIRS
      DEREF(job).triangle_offsets[c] =
         source_offset(selected[c]) |
         (leaf && selected[c] >= args.leaf_bound ? HK_AGX3_LEAF_PAIR_OFFSET : 0u);
#else
      DEREF(job).triangle_offsets[c] = source_offset(selected[c]);
#endif
      if (!leaf) {
         uint child_job =
            DEREF(INDEX(hk_agx3_plan_node, args.nodes, selected[c])).job;
         if (child_job >= DEREF(args.state).job_count) {
            fail(HK_AGX3_PLAN_SHAPE);
            return;
         }
         DEREF(INDEX(hk_agx3_leaf_job, args.jobs, child_job)).root_slot =
            first + c;
      }
   }
}

void
finish(uint id)
{
   if (id != 0)
      return;
   hk_agx3_envelope_job job;
   uint root = DEREF(args.state).error == 0 ? root_index() : 0;
   job.bounds =
      REF(vk_ir_node)(OFFSET(args.intermediate_bvh, source_offset(root)));
   job.output_bvh = args.output_bvh;
   job.end_slot = DEREF(args.state).next_slot;
   job.primitive_count =
      DEREF(args.state).error == 0 ? DEREF(args.header).active_leaf_count : 0;
   job.node_count = DEREF(args.state).job_count;
   job.depth = DEREF(args.state).depth;
   job.opaque_build_word = DEREF(args.state).error == HK_AGX3_PLAN_EMPTY
                             ? HK_AGX3_PLAN_EMPTY : 0;
   job.resource_id = args.resource_id;
   job.geometry_type = args.geometry_type;
   job.leaf_bound = args.leaf_bound;
   DEREF(args.envelope) = job;
   uint jobs = DEREF(args.state).error != 0 ? 0u : DEREF(args.state).job_count;
   if (DEREF(args.state).error != 0)
      DEREF(args.state).job_count = 0;
   uint64_t dispatch = uint64_t(args.state) + uint64_t(HK_AGX3_PLAN_ENCODE_DISPATCH);
   DEREF(REF(uint32_t)(dispatch)) =
      (jobs + HK_AGX3_NODE_JOBS_PER_GROUP - 1u) / HK_AGX3_NODE_JOBS_PER_GROUP;
   DEREF(REF(uint32_t)(dispatch + 4ul)) = 1u;
   DEREF(REF(uint32_t)(dispatch + 8ul)) = 1u;
}

void
main()
{
   uint id = gl_GlobalInvocationID.x;
   internal_count = DEREF(args.header).ir_internal_node_count;
   if (args.phase == 0) {
      initialize(id);
      return;
   }
   if (args.phase == 4) {
      finish(id);
      return;
   }
   if (DEREF(args.state).error != 0)
      return;
   if (args.phase == 1)
      link_and_count(id);
   if (args.phase == 2)
      classify(id);
   if (args.phase == 3)
      emit(id);
}
