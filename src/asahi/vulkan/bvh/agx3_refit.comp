/* Copyright 2026 Aurora Silicon
 * SPDX-License-Identifier: MIT
 *
 * Retained jobs of updatable structures (see hk_agx3_retained_job).
 * HK_AGX3_REFIT_SAVE keeps a full build's encoding jobs after its image, one
 * thread per job: it hands out their child offsets and positions.
 * HK_AGX3_REFIT_NUMBER numbers them leaf first and writes their records,
 * giving triangle leaves their slots, and HK_AGX3_REFIT_COUNT_LEVELS and
 * LIST_LEVELS link the records and list the inner jobs by level. Each job
 * keeps its children in their order, so the numbering changes no encoded
 * byte. HK_AGX3_REFIT_PREPARE readies an update, after its leaves: it
 * finds the source's jobs, copies them when updating into another
 * structure, clears the arrival counters and writes the refit state, the
 * level dispatches and the envelope job. Refit encoding then encodes the
 * leaf jobs, which the leaf-first numbering puts at the start, so its grid
 * and propagation's cover only those. HK_AGX3_REFIT_PROPAGATE encodes the
 * inner jobs deeper than the levels, one thread per leaf job, and
 * HK_AGX3_REFIT_INNER those of one level, eight lanes per job.
 *
 * Propagation runs apart from encoding: its device-scope arrivals wait for
 * the thread's earlier global stores, which in node encoding are a whole
 * node's.
 */
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#include "hk_build_interface.h"
#include "agx3_node.h"
#ifdef HK_AGX3_REFIT_TOP
layout(local_size_x = HK_AGX3_REFIT_TOP_GROUP_SIZE) in;
layout(push_constant) uniform CONSTS { hk_agx3_refit_top_args args; };
#else
layout(local_size_x = HK_AGX3_REFIT_GROUP_SIZE) in;
layout(push_constant) uniform CONSTS { hk_agx3_refit_args args; };
#endif

/* The retained level table: counts, then fill cursors. */
uint64_t
level_table(uint64_t retained, uint jobs)
{
   return retained + uint64_t(HK_AGX3_RETAINED_LEVELS(jobs, args.leaf_bound));
}

#ifndef HK_AGX3_REFIT_TOP
uint
leaf_size()
{
   return args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
             ? SIZEOF(vk_ir_instance_node)
             : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                ? SIZEOF(vk_ir_aabb_node) : SIZEOF(vk_ir_triangle_node);
}

/* Index into the retained inner jobs by level of the first of `level`. */
uint
level_start(uint64_t table, uint level)
{
   uint start = 0;
   for (uint l = 0; l < level && l < HK_AGX3_REFIT_LEVELS; ++l)
      start += DEREF(INDEX(uint32_t, table, l));
   return start;
}

/* Plan node of the IR node at `offset` (an IR leaf or internal node). */
uint
node_index(uint offset)
{
   return offset < args.root_offset
             ? offset / leaf_size()
             : args.leaf_bound + (offset - args.root_offset) / SIZEOF(vk_ir_box_node);
}

void
save(uint id)
{
   hk_agx3_plan_state plan = DEREF(REF(hk_agx3_plan_state)(args.plan_state));
   uint jobs = plan.job_count;
   REF(hk_agx3_retained_state) state = REF(hk_agx3_retained_state)(args.retained);
   uint64_t records = args.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   uint64_t offsets = records + uint64_t(jobs) * uint64_t(HK_AGX3_RETAINED_JOB_BYTES);
   if (id == 0) {
      uint root = args.leaf_bound + DEREF(args.header).ir_internal_node_count - 1u;
      hk_agx3_retained_state saved;
      saved.job_count = jobs;
      saved.root_job = jobs != 0u && root < args.node_bound
         ? DEREF(INDEX(hk_agx3_plan_node, args.plan_nodes, root)).job : 0xffffffffu;
      saved.end_slot = plan.next_slot;
      saved.depth = plan.depth;
      saved.deepest_level = 0;
      saved.active_leaves = DEREF(args.header).active_leaf_count;
      saved.leaf_jobs = 0;
      saved.inner_jobs = 0;
      DEREF(state) = saved;
      uint64_t table = level_table(args.retained, jobs);
      for (uint i = 0; i < HK_AGX3_REFIT_LEVELS * 2u; ++i)
         DEREF(INDEX(uint32_t, table, i)) = 0u;
   }
   if (id < args.leaf_bound)
      DEREF(INDEX(uint32_t, args.retained + uint64_t(HK_AGX3_RETAINED_SLOTS(jobs, args.leaf_bound)),
                  id)) = ~0u;
   if (id >= jobs)
      return;
   hk_agx3_leaf_job job = DEREF(INDEX(hk_agx3_leaf_job, args.plan_jobs, id));
   uint count = min(job.child_count, 8u);
   /* Hand out the job's child offsets or positions only, and keep the
    * first in its status: number() writes its record under its new id. */
   REF(hk_agx3_plan_state) cursors = REF(hk_agx3_plan_state)(args.plan_state);
   uint first;
   if (job.node_kind == HK_AGX3_NODE_INNER) {
      first = atomicAdd(DEREF(cursors).saved_positions, count);
   } else {
      first = atomicAdd(DEREF(cursors).saved_offsets, count);
      for (uint c = 0; c < count; ++c)
         DEREF(INDEX(uint32_t, offsets, first + c)) = job.triangle_offsets[c];
   }
   DEREF(INDEX(uint32_t, args.status, id)) = first;
}

/* Give job `id` of the plan its retained id, leaf jobs from 0 and inner
 * jobs down from job_count - 1, counted in the retained state. Write its
 * record but for its parent and position, which count_levels() links, give
 * a triangle leaf job's leaves their slots, the indices of their child
 * offsets, and leave the retained id in the job's status. */
void
number(uint id)
{
   REF(hk_agx3_retained_state) state = REF(hk_agx3_retained_state)(args.retained);
   uint jobs = DEREF(state).job_count;
   if (id >= jobs)
      return;
   hk_agx3_leaf_job job = DEREF(INDEX(hk_agx3_leaf_job, args.plan_jobs, id));
   uint first = DEREF(INDEX(uint32_t, args.status, id));
   uint retained = job.node_kind == HK_AGX3_NODE_INNER
      ? jobs - 1u - atomicAdd(DEREF(state).inner_jobs, 1u)
      : atomicAdd(DEREF(state).leaf_jobs, 1u);
   uint64_t records = args.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   REF(hk_agx3_retained_job) record = INDEX(hk_agx3_retained_job, records, retained);
   DEREF(record).root_slot = job.root_slot;
   DEREF(record).child_slot = job.child_slot;
   DEREF(record).kind_count = job.child_count | (job.node_kind << 4);
   DEREF(record).first = first;
   if (job.root_slot == 0u) {
      DEREF(record).parent = 0xffffffffu;
      DEREF(record).position = jobs - 1u;
      DEREF(state).root_job = retained;
   }
   if (job.node_kind == HK_AGX3_NODE_LEAF) {
      uint64_t slots = args.retained + uint64_t(HK_AGX3_RETAINED_SLOTS(jobs, args.leaf_bound));
      for (uint c = 0; c < min(job.child_count, 8u); ++c) {
         uint leaf = job.triangle_offsets[c] / leaf_size();
         if (leaf < args.leaf_bound)
            DEREF(INDEX(uint32_t, slots, leaf)) = first + c;
      }
   }
   DEREF(INDEX(uint32_t, args.status, id)) = retained;
}

/* Link the records of job `id` of the plan and of its children under the
 * retained ids number() left in their statuses: an inner job gives each
 * child its parent and position, and each inner child its level, counting
 * the inner jobs of each level. */
void
count_levels(uint id)
{
   REF(hk_agx3_retained_state) state = REF(hk_agx3_retained_state)(args.retained);
   uint jobs = DEREF(state).job_count;
   uint64_t records = args.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   uint64_t table = level_table(args.retained, jobs);
   uint deepest = 0;
   hk_agx3_leaf_job job;
   bool inner = false;
   if (id < jobs) {
      job = DEREF(INDEX(hk_agx3_leaf_job, args.plan_jobs, id));
      inner = job.node_kind == HK_AGX3_NODE_INNER;
   }
   if (inner) {
      /* The root is the inner job of level 0. */
      if (job.root_slot == 0u)
         atomicAdd(DEREF(INDEX(uint32_t, table, 0u)), 1u);
      uint retained = DEREF(INDEX(uint32_t, args.status, id));
      uint first = DEREF(INDEX(hk_agx3_retained_job, records, retained)).first;
      for (uint c = 0; c < min(job.child_count, 8u); ++c) {
         hk_agx3_plan_node node = DEREF(INDEX(hk_agx3_plan_node, args.plan_nodes,
                                              node_index(job.triangle_offsets[c])));
         if (node.job >= jobs)
            continue;
         uint child = DEREF(INDEX(uint32_t, args.status, node.job));
         REF(hk_agx3_retained_job) child_record = INDEX(hk_agx3_retained_job, records, child);
         DEREF(child_record).parent = retained;
         DEREF(child_record).position = first + c;
         uint kind_count = DEREF(child_record).kind_count;
         if (((kind_count >> 4) & 15u) != HK_AGX3_NODE_INNER)
            continue;
         /* Inner jobs sit at depths of whole levels. */
         uint level = (node.depth & ~(HK_AGX3_PLAN_PAIR | HK_AGX3_PLAN_PAIR_OPAQUE)) / 3u;
         DEREF(child_record).kind_count = kind_count | (level << 8);
         if (level < HK_AGX3_REFIT_LEVELS)
            atomicAdd(DEREF(INDEX(uint32_t, table, level)), 1u);
         deepest = max(deepest, level);
      }
   }
   deepest = subgroupMax(deepest);
   if (subgroupElect() && deepest != 0u)
      atomicMax(DEREF(state).deepest_level, deepest);
}

/* List the inner jobs of the first HK_AGX3_REFIT_LEVELS levels by level. */
void
list_levels(uint id)
{
   uint jobs = DEREF(REF(hk_agx3_retained_state)(args.retained)).job_count;
   if (id >= jobs)
      return;
   uint64_t records = args.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   uint kind_count = DEREF(INDEX(hk_agx3_retained_job, records, id)).kind_count;
   uint level = kind_count >> 8;
   if (((kind_count >> 4) & 15u) != HK_AGX3_NODE_INNER || level >= HK_AGX3_REFIT_LEVELS)
      return;
   uint64_t table = level_table(args.retained, jobs);
   uint index = level_start(table, level) +
      atomicAdd(DEREF(INDEX(uint32_t, table, HK_AGX3_REFIT_LEVELS + level)), 1u);
   uint64_t list = table + uint64_t(HK_AGX3_RETAINED_LEVEL_BYTES);
   DEREF(INDEX(uint32_t, list, index)) = id;
}

void
prepare(uint id)
{
   uint64_t source = args.retained;
   if (args.metadata != 0ul) {
      libagx_gen1_as_metadata live = DEREF(REF(libagx_gen1_as_metadata)(args.metadata));
      source = live.native_base + live.retained_offset;
   }
   hk_agx3_retained_state saved = DEREF(REF(hk_agx3_retained_state)(source));
   uint jobs = saved.job_count;
   uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
   if (args.copy != 0u) {
      /* An update into another structure keeps it updatable: copy the state,
       * the records and every child offset the leaf jobs may use. */
      uint words = HK_AGX3_RETAINED_BYTES(jobs, args.leaf_bound) / 4u;
      for (uint i = id; i < words; i += stride)
         DEREF(INDEX(uint32_t, args.retained, i)) = DEREF(INDEX(uint32_t, source, i));
   }
   if (saved.deepest_level >= args.level && args.counters != 0ul) {
      for (uint i = id; i < jobs; i += stride)
         DEREF(INDEX(uint32_t, args.counters, i)) = 0u;
   }

   bool instances = args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR;
   uint64_t transforms = uint64_t(saved.end_slot) * 64ul;
   uint64_t pointers = transforms + 64ul * uint64_t(args.leaf_bound);
   /* Instance encoding fills the pointer of every active instance. */
   if (instances && jobs != 0u) {
      for (uint i = id; i < args.leaf_bound; i += stride) {
         uint64_t entry = args.output_bvh + pointers + uint64_t(i) * 16ul;
         DEREF(REF(uint64_t)(entry)) = 0ul;
         DEREF(REF(uint64_t)(entry + 8ul)) = 0ul;
      }
   }
   if (id != 0)
      return;
   /* Refit encoding and propagation start from the leaf jobs only, those
    * below the first inner job. Counts that do not add up to the jobs
    * leave both to cover every job. */
   uint leaves = saved.leaf_jobs;
   if (leaves > jobs || leaves + saved.inner_jobs != jobs)
      leaves = jobs;
   hk_agx3_refit_state refit;
   refit.dispatch[0] = (leaves + HK_AGX3_NODE_JOBS_PER_GROUP - 1u) / HK_AGX3_NODE_JOBS_PER_GROUP;
   refit.dispatch[1] = 1u;
   refit.dispatch[2] = 1u;
   refit.job_count = jobs;
   refit.retained = args.copy != 0u ? args.retained : source;
   /* Propagation only for inner jobs past the levels. */
   refit.propagate[0] = saved.deepest_level >= args.level
      ? (leaves + HK_AGX3_REFIT_GROUP_SIZE - 1u) / HK_AGX3_REFIT_GROUP_SIZE : 0u;
   refit.propagate[1] = 1u;
   refit.propagate[2] = 1u;
   refit.end_slot = saved.end_slot;
   DEREF(REF(hk_agx3_refit_state)(args.refit)) = refit;
   /* Workgroups of HK_AGX3_REFIT_GROUP_SIZE / 8 jobs for each level the
    * update encodes by level, all from this thread: a small structure runs
    * fewer threads than there are levels, and a level left unwritten would
    * dispatch whatever the scratch held. */
   if (args.levels != 0ul) {
      uint64_t table = level_table(source, jobs);
      const uint per_group = HK_AGX3_REFIT_GROUP_SIZE / 8u;
      for (uint l = 0; l < args.level && l < HK_AGX3_REFIT_LEVELS; ++l) {
         uint count = min(DEREF(INDEX(uint32_t, table, l)), jobs);
         uint64_t dispatch = args.levels + uint64_t(l) * 12ul;
         store32(dispatch, (count + per_group - 1u) / per_group);
         store32(dispatch + 4ul, 1u);
         store32(dispatch + 8ul, 1u);
      }
   }

   if (args.envelope != 0ul) {
      uint active_leaves = args.no_leaves != 0u ? saved.active_leaves
                                                : DEREF(args.header).active_leaf_count;
      bool empty = jobs == 0u || active_leaves == 0u;
      hk_agx3_envelope_job job;
      job.bounds = REF(vk_ir_node)(args.bounds + uint64_t(jobs != 0u ? jobs - 1u : 0u) *
                                   uint64_t(SIZEOF(vk_aabb)));
      job.output_bvh = args.output_bvh;
      job.end_slot = saved.end_slot;
      job.primitive_count = empty ? 0u : active_leaves;
      job.node_count = jobs;
      job.depth = saved.depth;
      job.opaque_build_word = empty ? HK_AGX3_PLAN_EMPTY : 0u;
      job.resource_id = args.resource_id;
      job.geometry_type = args.geometry_type;
      job.leaf_bound = args.leaf_bound;
      DEREF(REF(hk_agx3_envelope_job)(args.envelope)) = job;
   }
}

/* From leaf job `id`, whose bounds refit encoding left at its position:
 * arrive at the parent; while this was the parent's last child, encode the
 * parent's node from its children's bounds, leave the parent's bounds at
 * its position and arrive at its parent in turn. The arrival orders the
 * bounds stores of every child before the reads of the last. Parents of
 * the levels encoded by level are left to those. */
void
propagate(uint id)
{
   hk_agx3_refit_state refit = DEREF(REF(hk_agx3_refit_state)(args.refit));
   if (id >= refit.job_count)
      return;
   uint64_t records = refit.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   hk_agx3_retained_job leaf = DEREF(INDEX(hk_agx3_retained_job, records, id));
   if (((leaf.kind_count >> 4) & 15u) == HK_AGX3_NODE_INNER)
      return;
   uint parent = leaf.parent;
   for (uint steps = 0; parent != 0xffffffffu && steps < 64u; ++steps) {
      hk_agx3_retained_job job = DEREF(INDEX(hk_agx3_retained_job, records, parent));
      if ((job.kind_count >> 8) < args.level)
         return;
      uint count = job.kind_count & 15u;
      uint arrived = atomicAdd(DEREF(INDEX(uint32_t, args.counters, parent)), 1u,
         gl_ScopeDevice, gl_StorageSemanticsBuffer,
         gl_SemanticsAcquireRelease | gl_SemanticsMakeAvailable | gl_SemanticsMakeVisible);
      if (arrived + 1u != count)
         return;
      vec3 child_lo[8], child_hi[8];
      vec3 lo = vec3(INFINITY), hi = vec3(-INFINITY);
      for (uint c = 0; c < count && c < 8u; ++c) {
         child_lo[c] = DEREF(INDEX(vk_aabb, args.bounds, job.first + c)).min;
         child_hi[c] = DEREF(INDEX(vk_aabb, args.bounds, job.first + c)).max;
         lo = min(lo, child_lo[c]);
         hi = max(hi, child_hi[c]);
      }
      vec3 base;
      uvec3 exponent;
      bool ok = count >= 1u && count <= 8u && fit_root(lo, hi, base, exponent);
      uint64_t words[8];
      for (uint t = 0; t < 8u && ok; ++t)
         words[t] = root_word(t, count, HK_AGX3_NODE_INNER, 0u, job.child_slot,
                              args.slot_bias, base, exponent, child_lo[t], child_hi[t], ok);
      if (ok) {
         uint64_t node = args.output_bvh + uint64_t(job.root_slot) * 64ul;
         for (uint t = 0; t < 8u; ++t)
            store_word64(node + uint64_t(t) * 8ul, words[t]);
      } else {
         lo = hi = HK_AGX3_FAILED_BOUNDS;
      }
      store_aabb(uint64_t(INDEX(vk_aabb, args.bounds, job.position)), lo, hi);
      DEREF(INDEX(uint32_t, args.status, parent)) = ok ? HK_AGX3_LEAF_SUCCESS : HK_AGX3_LEAF_RANGE;
      parent = job.parent;
   }
}

/* Inner jobs of level args.level, whose children are encoded: eight lanes
 * per job, a lane per child for its bounds and root word. Every lane
 * reaches every subgroup operation. A job whose children's bounds do not
 * fit, as when a child failed, fails in turn. */
void
inner(uint id)
{
   uint slot = id / 8u, lane = id % 8u;
   hk_agx3_refit_state refit = DEREF(REF(hk_agx3_refit_state)(args.refit));
   uint64_t records = refit.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   uint64_t table = level_table(refit.retained, refit.job_count);
   bool live = slot < min(DEREF(INDEX(uint32_t, table, args.level)), refit.job_count);
   uint index = 0, count = 0;
   hk_agx3_retained_job job;
   vec3 my_lo = vec3(INFINITY), my_hi = vec3(-INFINITY);
   if (live) {
      uint64_t list = table + uint64_t(HK_AGX3_RETAINED_LEVEL_BYTES);
      index = DEREF(INDEX(uint32_t, list, level_start(table, args.level) + slot));
      job = DEREF(INDEX(hk_agx3_retained_job, records, index));
      count = job.kind_count & 15u;
      if (lane < count) {
         my_lo = DEREF(INDEX(vk_aabb, args.bounds, job.first + lane)).min;
         my_hi = DEREF(INDEX(vk_aabb, args.bounds, job.first + lane)).max;
      }
   }
   vec3 lo = subgroupClusteredMin(my_lo, 8u);
   vec3 hi = subgroupClusteredMax(my_hi, 8u);
   vec3 base;
   uvec3 exponent;
   bool ok = live && count >= 1u && count <= 8u && fit_root(lo, hi, base, exponent);
   uint64_t word = 0ul;
   if (ok)
      word = root_word(lane, count, HK_AGX3_NODE_INNER, 0u, job.child_slot, args.slot_bias,
                       base, exponent, my_lo, my_hi, ok);
   bool bad = subgroupClusteredOr(ok ? 0u : 1u, 8u) != 0u;
   if (!live)
      return;
   if (bad) {
      if (lane == 0u) {
         DEREF(INDEX(uint32_t, args.status, index)) = HK_AGX3_LEAF_RANGE;
         store_aabb(uint64_t(INDEX(vk_aabb, args.bounds, job.position)),
                    HK_AGX3_FAILED_BOUNDS, HK_AGX3_FAILED_BOUNDS);
      }
      return;
   }
   store_word64(args.output_bvh + uint64_t(job.root_slot) * 64ul + uint64_t(lane) * 8ul, word);
   if (lane == 0u) {
      store_aabb(uint64_t(INDEX(vk_aabb, args.bounds, job.position)), lo, hi);
      DEREF(INDEX(uint32_t, args.status, index)) = HK_AGX3_LEAF_SUCCESS;
   }
}

void
main()
{
   uint id = gl_GlobalInvocationID.x;
   /* Built once per update phase that runs per level or per job
    * (HK_AGX3_REFIT_ONLY_PHASE), so those carry only their own registers,
    * and once for the other phases. */
#ifdef HK_AGX3_REFIT_ONLY_PHASE
   const uint phase = HK_AGX3_REFIT_ONLY_PHASE;
#else
   const uint phase = args.phase;
#endif
   if (phase == HK_AGX3_REFIT_SAVE)
      save(id);
   else if (phase == HK_AGX3_REFIT_PREPARE)
      prepare(id);
   else if (phase == HK_AGX3_REFIT_PROPAGATE)
      propagate(id);
   else if (phase == HK_AGX3_REFIT_COUNT_LEVELS)
      count_levels(id);
   else if (phase == HK_AGX3_REFIT_LIST_LEVELS)
      list_levels(id);
   else if (phase == HK_AGX3_REFIT_NUMBER)
      number(id);
   else
      inner(id);
}
#else /* HK_AGX3_REFIT_TOP */

shared uint s_level_count[HK_AGX3_REFIT_LEVELS];
shared uint s_level_start[HK_AGX3_REFIT_LEVELS];

/* Exact round-to-nearest-even reciprocal matching agx3_envelope.comp. */
uint
reciprocal_rte(float value)
{
   uint bits = floatBitsToUint(value);
   if ((bits & 0x80000000u) != 0u || (bits & 0x7fffffffu) == 0u ||
       (bits & 0x7f800000u) == 0x7f800000u)
      return 0x7f800000u;
   int exponent = int((bits >> 23) & 255u);
   uint mantissa = bits & 0x7fffffu;
   if (exponent != 0) {
      mantissa |= 0x800000u;
   } else {
      int shift = 23 - findMSB(mantissa);
      mantissa <<= shift;
      exponent = 1 - shift;
   }
   int result_exponent = max(253 - exponent, 0);
   if (result_exponent >= 255)
      return 0x7f800000u;
   int numerator_bit = result_exponent == 0 ? 299 - exponent : 47;
   uint64_t numerator = 1ul << numerator_bit;
   uint estimate_bits = floatBitsToUint(1.0 / float(mantissa));
   int estimate_exponent = int((estimate_bits >> 23) & 255u);
   uint estimate_mantissa = 0x800000u | (estimate_bits & 0x7fffffu);
   int estimate_shift = 150 - numerator_bit - estimate_exponent;
   uint quotient = estimate_shift < 0
                      ? estimate_mantissa << uint(-estimate_shift)
                      : estimate_mantissa >> uint(estimate_shift);
   uint64_t product = uint64_t(mantissa) * uint64_t(quotient);
   while (product > numerator) {
      --quotient;
      product -= uint64_t(mantissa);
   }
   while (product + uint64_t(mantissa) <= numerator) {
      ++quotient;
      product += uint64_t(mantissa);
   }
   uint64_t twice_remainder = (numerator - product) * 2ul;
   if (twice_remainder > uint64_t(mantissa) ||
       (twice_remainder == uint64_t(mantissa) && (quotient & 1u) != 0u))
      ++quotient;
   if (quotient == 0x1000000u) {
      quotient >>= 1;
      ++result_exponent;
   }
   return result_exponent == 0
             ? quotient
             : (uint(result_exponent) << 23) | (quotient & 0x7fffffu);
}

void
publish_refit_metadata(uint jobs, uint64_t image_bytes)
{
   if (args.metadata == 0ul)
      return;
   libagx_gen1_as_metadata live;
   live.native_base = args.output_bvh;
   live.image_bytes = image_bytes;
   live.retained_offset = 0ul;
   live.retained_bytes = 0ul;
   if ((args.flags & HK_AGX3_REFIT_TOP_KEEP_RETAINED) != 0u) {
      libagx_gen1_as_metadata previous =
         DEREF(REF(libagx_gen1_as_metadata)(args.metadata));
      live.retained_offset = previous.retained_offset;
      live.retained_bytes = previous.retained_bytes;
   } else if ((args.build_flags & 1u) != 0u) { /* Vulkan ALLOW_UPDATE */
      live.retained_offset = args.retained_offset;
      live.retained_bytes =
         uint64_t(HK_AGX3_RETAINED_BYTES(jobs, args.leaf_bound));
   }
   live.storage_bytes = max(image_bytes, live.retained_offset + live.retained_bytes);
   live.build_flags = args.build_flags;
   live.leaf_bound = args.leaf_bound;
   live.node_bound = args.node_bound;
   live.geometry_type = args.geometry_type;
   live.resource_id = args.resource_id;
   live.version = LIBAGX_GEN1_AS_METADATA_VERSION;
   DEREF(REF(libagx_gen1_as_metadata)(args.metadata)) = live;
}

/* Compute half the bounding-box surface area with NoContraction, padding any
 * flat axis to match agx3_envelope.comp. Kept in a pure helper (no buffer
 * references) so glslang's precise propagation stays local. */
float
envelope_half_area(vec3 lo, inout vec3 hi, inout uint status)
{
   precise vec3 extent = hi - lo;
   for (uint a = 0u; a < 3u; ++a) {
      if (isnan(lo[a]) || isinf(lo[a]) || isnan(hi[a]) || isinf(hi[a]))
         status |= HK_AGX3_LEAF_NONFINITE;
      if (lo[a] > hi[a])
         status |= HK_AGX3_LEAF_RANGE;
      if (extent[a] == 0.0) {
         hi[a] = lo[a] + max(abs(lo[a]), 1.0) * 1.52587890625e-05;
         extent[a] = hi[a] - lo[a];
      }
   }
   precise float xy = extent.x * extent.y;
   precise float xz = extent.x * extent.z;
   precise float yz = extent.y * extent.z;
   precise float area = (xy + xz) + yz;
   return area;
}

void
finish_refit_envelope(hk_agx3_retained_state saved, uint jobs)
{
   uint active_leaves = (args.flags & HK_AGX3_REFIT_TOP_NO_LEAVES) != 0u
                           ? saved.active_leaves
                           : DEREF(args.header).active_leaf_count;
   bool empty = jobs == 0u || active_leaves == 0u;
   if (empty) {
      if (args.output_bvh == 0ul || (args.output_bvh & 63ul) != 0ul ||
          args.output_bvh >= (1ul << 48) - 192ul) {
         DEREF(args.envelope_status) = HK_AGX3_LEAF_RANGE;
         return;
      }
      for (uint i = 0u; i < 48u; ++i)
         store32(args.output_bvh + uint64_t(i) * 4ul,
                 i >= 20u && i < 26u ? 0x7fc00000u : 0u);
      store_word64(args.output_bvh + 144ul, args.output_bvh);
      store32(args.output_bvh + 176ul,
              args.resource_id != 0u ? args.resource_id : 1u);
      publish_refit_metadata(jobs, 192ul);
      DEREF(args.envelope_status) = HK_AGX3_LEAF_SUCCESS;
      return;
   }

   uint64_t tail = uint64_t(saved.end_slot) * 64ul;
   bool instances = args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR;
   uint64_t transform_offset = tail;
   uint64_t pointer_offset = tail + 64ul * uint64_t(args.leaf_bound);
   uint64_t descriptor_offset = instances
      ? pointer_offset + 16ul * uint64_t(args.leaf_bound) : tail;
   uint64_t size = descriptor_offset + 184ul;
   uint status = 0u;
   if (saved.end_slot < 3u || active_leaves == 0u || jobs == 0u ||
       saved.depth == 0u)
      status |= HK_AGX3_LEAF_INVALID_COUNT;
   if (args.output_bvh == 0ul || (args.output_bvh & 63ul) != 0ul ||
       args.output_bvh >= (1ul << 48) || size > (1ul << 48) - args.output_bvh)
      status |= HK_AGX3_LEAF_RANGE;

   vk_aabb root_bounds = DEREF(INDEX(vk_aabb, args.bounds, jobs - 1u));
   vec3 lo = root_bounds.min, hi = root_bounds.max;
   float area = envelope_half_area(lo, hi, status);
   uint inverse_bits = reciprocal_rte(area);
   float inverse = uintBitsToFloat(inverse_bits);
   if (!(area > 0.0) || isinf(area) || isinf(inverse))
      status |= HK_AGX3_LEAF_RANGE;
   if (status != 0u) {
      DEREF(args.envelope_status) = status;
      return;
   }

   uint64_t h = args.output_bvh + 64ul;
   uint64_t h0 = (instances ? 0x080000008000f032ul : 0x080000002000f032ul) |
                 (uint64_t(2u) << 24);
   uint64_t off40 = instances ? transform_offset : tail;
   uint64_t off48 = instances ? descriptor_offset : tail;
   uint64_t off64 = instances ? pointer_offset : tail;
   store128(h, uvec4(unpackUint2x32(h0), unpackUint2x32(size)));
   store128(h + 16ul, uvec4(floatBitsToUint(lo.x), floatBitsToUint(lo.y),
                            floatBitsToUint(lo.z), floatBitsToUint(hi.x)));
   store128(h + 32ul, uvec4(floatBitsToUint(hi.y), floatBitsToUint(hi.z),
                            unpackUint2x32(off40)));
   store128(h + 48ul, uvec4(unpackUint2x32(off48), unpackUint2x32(off48)));
   store128(h + 64ul, uvec4(unpackUint2x32(off64), unpackUint2x32(off40)));
   store128(h + 80ul, uvec4(unpackUint2x32(args.output_bvh), unpackUint2x32(off40)));
   store128(h + 96ul, uvec4(1u, 0u, 0u, 0u));
   store128(h + 112ul, uvec4(args.resource_id != 0u ? args.resource_id : 1u,
                             0u, instances ? 0x41d00000u : 0u, 0x01000000u));

   uint64_t d = args.output_bvh + descriptor_offset;
   if (instances) {
      store128(d, uvec4(active_leaves, 0u, 0u, active_leaves));
      store128(d + 16ul, uvec4(jobs, saved.depth, 0u, active_leaves));
      store128(d + 32ul, uvec4(1u, 0u, 0u, 0u));
      store128(d + 48ul, uvec4(0u, 0x3f800000u, 0u, 0u));
      store128(d + 64ul, uvec4(8u, 0u, 0u, 0u));
      store128(d + 80ul, uvec4(8u, 18u, 0u, 6u));
      store128(d + 96ul, uvec4(1u, 1u, 1u, inverse_bits));
      store128(d + 112ul, uvec4(0x01000000u, 0u, 0x00000100u, 0x00010000u));
      store128(d + 128ul, uvec4(0x00010000u, 0x00ff0001u, 0x02000000u, 5u));
      store128(d + 144ul, uvec4(0x03000002u, 1u, 0u, 0x3f800000u));
   } else {
      store128(d, uvec4(active_leaves, active_leaves, 0u, 0u));
      store128(d + 16ul, uvec4(jobs, saved.depth, 1u, 0u));
      store128(d + 32ul, uvec4(1u, 0u, 0u, 0u));
      store128(d + 48ul, uvec4(0u, 0x3f800000u, 0u, 0u));
      store128(d + 64ul, uvec4(2u, 1u, 0u, 0u));
      store128(d + 80ul, uvec4(2u, 10u, 0u, 0u));
      store128(d + 96ul, uvec4(0u, 0u, 0u, inverse_bits));
      store128(d + 112ul, uvec4(0x01000000u, 0x01000000u, 0x00000101u, 0x00010000u));
      store128(d + 128ul, uvec4(0x00010000u, 0x00ff0001u, 0x02000000u, 0x01000005u));
      store128(d + 144ul, uvec4(0x03000000u, 1u, 0u, 0x3f800000u));
   }
   store128(d + 160ul, uvec4(0u));
   store32(d + 176ul, 0u);
   store32(d + 180ul, 0u);

   publish_refit_metadata(jobs, size);
   DEREF(args.envelope_status) = HK_AGX3_LEAF_SUCCESS;
}

/* Fallback for degenerate trees deeper than HK_AGX3_REFIT_LEVELS when
 * running all inner levels in one workgroup. */
void
propagate_top(uint tid, uint64_t records, uint jobs, uint leaves)
{
   for (uint i = tid; i < jobs; i += HK_AGX3_REFIT_TOP_GROUP_SIZE)
      DEREF(INDEX(uint32_t, args.counters, i)) = 0u;
   controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup,
                  gl_StorageSemanticsBuffer,
                  gl_SemanticsAcquireRelease | gl_SemanticsMakeAvailable |
                     gl_SemanticsMakeVisible);
   for (uint i = tid; i < leaves; i += HK_AGX3_REFIT_TOP_GROUP_SIZE) {
      hk_agx3_retained_job leaf = DEREF(INDEX(hk_agx3_retained_job, records, i));
      if (((leaf.kind_count >> 4) & 15u) == HK_AGX3_NODE_INNER)
         continue;
      uint parent = leaf.parent;
      for (uint steps = 0u; parent != 0xffffffffu && steps < 64u; ++steps) {
         hk_agx3_retained_job job = DEREF(INDEX(hk_agx3_retained_job, records, parent));
         if ((job.kind_count >> 8) < HK_AGX3_REFIT_LEVELS)
            break;
         uint count = job.kind_count & 15u;
         uint arrived = atomicAdd(DEREF(INDEX(uint32_t, args.counters, parent)), 1u,
            gl_ScopeWorkgroup, gl_StorageSemanticsBuffer,
            gl_SemanticsAcquireRelease | gl_SemanticsMakeAvailable | gl_SemanticsMakeVisible);
         if (arrived + 1u != count)
            break;
         vec3 lo = vec3(INFINITY), hi = vec3(-INFINITY);
         for (uint c = 0u; c < count && c < 8u; ++c) {
            lo = min(lo, DEREF(INDEX(vk_aabb, args.bounds, job.first + c)).min);
            hi = max(hi, DEREF(INDEX(vk_aabb, args.bounds, job.first + c)).max);
         }
         vec3 base;
         uvec3 exponent;
         bool ok = count >= 1u && count <= 8u && fit_root(lo, hi, base, exponent);
         for (uint t = 0u; t < 8u && ok; ++t) {
            vec3 c_lo = vec3(INFINITY), c_hi = vec3(-INFINITY);
            if (t < count) {
               c_lo = DEREF(INDEX(vk_aabb, args.bounds, job.first + t)).min;
               c_hi = DEREF(INDEX(vk_aabb, args.bounds, job.first + t)).max;
            }
            root_word(t, count, HK_AGX3_NODE_INNER, 0u, job.child_slot,
                      args.slot_bias, base, exponent, c_lo, c_hi, ok);
         }
         if (ok) {
            uint64_t node = args.output_bvh + uint64_t(job.root_slot) * 64ul;
            for (uint t = 0u; t < 8u; ++t) {
               vec3 c_lo = vec3(INFINITY), c_hi = vec3(-INFINITY);
               if (t < count) {
                  c_lo = DEREF(INDEX(vk_aabb, args.bounds, job.first + t)).min;
                  c_hi = DEREF(INDEX(vk_aabb, args.bounds, job.first + t)).max;
               }
               bool word_ok = true;
               uint64_t word = root_word(t, count, HK_AGX3_NODE_INNER, 0u,
                                         job.child_slot, args.slot_bias,
                                         base, exponent, c_lo, c_hi, word_ok);
               store_word64(node + uint64_t(t) * 8ul, word);
            }
         } else {
            lo = hi = HK_AGX3_FAILED_BOUNDS;
         }
         store_aabb(uint64_t(INDEX(vk_aabb, args.bounds, job.position)), lo, hi);
         DEREF(INDEX(uint32_t, args.status, parent)) =
            ok ? HK_AGX3_LEAF_SUCCESS : HK_AGX3_LEAF_RANGE;
         parent = job.parent;
      }
   }
   controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup,
                  gl_StorageSemanticsBuffer,
                  gl_SemanticsAcquireRelease | gl_SemanticsMakeAvailable |
                     gl_SemanticsMakeVisible);
}

/* Single-workgroup fused inner-level refit and envelope writer. Processes
 * levels min(deepest_level, top_levels - 1) down to 0 in 8-lane batches
 * (32 jobs per iteration), synchronizing inter-level bounds writes within the
 * workgroup, then writes the AS header, descriptor and live metadata on
 * lane 0. */
void
main()
{
   uint tid = gl_LocalInvocationID.x;
   uint local_slot = tid / 8u;
   uint lane = tid % 8u;
   const uint jobs_per_iter = HK_AGX3_REFIT_TOP_GROUP_SIZE / 8u;

   uint64_t retained = 0ul;
   hk_agx3_retained_state saved;
   saved.job_count = 0u;
   saved.root_job = 0xffffffffu;
   saved.end_slot = 0u;
   saved.depth = 0u;
   saved.deepest_level = 0u;
   saved.active_leaves = 0u;
   saved.leaf_jobs = 0u;
   saved.inner_jobs = 0u;
   if (args.refit != 0ul) {
      retained = DEREF(REF(hk_agx3_refit_state)(args.refit)).retained;
      saved = DEREF(REF(hk_agx3_retained_state)(retained));
   } else if (args.metadata != 0ul) {
      libagx_gen1_as_metadata live =
         DEREF(REF(libagx_gen1_as_metadata)(args.metadata));
      if (live.retained_bytes != 0ul) {
         retained = live.native_base + live.retained_offset;
         saved = DEREF(REF(hk_agx3_retained_state)(retained));
      }
   }
   uint jobs = saved.job_count;

   if (jobs != 0u && args.top_levels != 0u) {
      uint64_t records = retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
      uint64_t table = level_table(retained, jobs);
      uint64_t list = table + uint64_t(HK_AGX3_RETAINED_LEVEL_BYTES);

      if (tid == 0u) {
         uint sum = 0u;
         for (uint l = 0u; l < HK_AGX3_REFIT_LEVELS; ++l) {
            uint c = min(DEREF(INDEX(uint32_t, table, l)), jobs);
            s_level_count[l] = c;
            s_level_start[l] = sum;
            sum += c;
         }
      }
      controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup,
                     gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);

      if (args.top_levels >= HK_AGX3_REFIT_LEVELS &&
          saved.deepest_level >= HK_AGX3_REFIT_LEVELS) {
         uint leaves = saved.leaf_jobs;
         if (leaves > jobs || leaves + saved.inner_jobs != jobs)
            leaves = jobs;
         propagate_top(tid, records, jobs, leaves);
      }

      uint start_level = min(saved.deepest_level, args.top_levels - 1u);
      for (int lvl = int(start_level); lvl >= 0; --lvl) {
         uint level_count = s_level_count[lvl];
         if (level_count == 0u)
            continue;
         uint base_idx = s_level_start[lvl];
         for (uint batch = 0u; batch < level_count; batch += jobs_per_iter) {
            uint slot = batch + local_slot;
            bool live = slot < level_count;
            uint index = 0u, count = 0u;
            hk_agx3_retained_job job;
            vec3 my_lo = vec3(INFINITY), my_hi = vec3(-INFINITY);
            if (live) {
               index = DEREF(INDEX(uint32_t, list, base_idx + slot));
               job = DEREF(INDEX(hk_agx3_retained_job, records, index));
               count = job.kind_count & 15u;
               if (lane < count) {
                  my_lo = DEREF(INDEX(vk_aabb, args.bounds, job.first + lane)).min;
                  my_hi = DEREF(INDEX(vk_aabb, args.bounds, job.first + lane)).max;
               }
            }
            vec3 lo = subgroupClusteredMin(my_lo, 8u);
            vec3 hi = subgroupClusteredMax(my_hi, 8u);
            vec3 base;
            uvec3 exponent;
            bool ok = live && count >= 1u && count <= 8u && fit_root(lo, hi, base, exponent);
            uint64_t word = 0ul;
            if (ok)
               word = root_word(lane, count, HK_AGX3_NODE_INNER, 0u, job.child_slot,
                                args.slot_bias, base, exponent, my_lo, my_hi, ok);
            bool bad = subgroupClusteredOr(ok ? 0u : 1u, 8u) != 0u;
            if (live) {
               if (bad) {
                  if (lane == 0u) {
                     DEREF(INDEX(uint32_t, args.status, index)) = HK_AGX3_LEAF_RANGE;
                     store_aabb(uint64_t(INDEX(vk_aabb, args.bounds, job.position)),
                                HK_AGX3_FAILED_BOUNDS, HK_AGX3_FAILED_BOUNDS);
                  }
               } else {
                  store_word64(args.output_bvh + uint64_t(job.root_slot) * 64ul +
                               uint64_t(lane) * 8ul, word);
                  if (lane == 0u) {
                     store_aabb(uint64_t(INDEX(vk_aabb, args.bounds, job.position)), lo, hi);
                     DEREF(INDEX(uint32_t, args.status, index)) = HK_AGX3_LEAF_SUCCESS;
                  }
               }
            }
         }
         controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup,
                        gl_StorageSemanticsBuffer,
                        gl_SemanticsAcquireRelease | gl_SemanticsMakeAvailable |
                           gl_SemanticsMakeVisible);
      }
   }

   if (tid == 0u)
      finish_refit_envelope(saved, jobs);
}
#endif /* HK_AGX3_REFIT_TOP */
