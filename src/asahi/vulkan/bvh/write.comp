 *
 * Write a push-constant blob to a device address (backs vk_device::write_buffer_cp
 * to seed the common AS builder's vk_ir_header). Uses a shader because AGX has
 * no CP memory-write path and G17P dispatch fail-closes on libagx precomputed
 * copy kernels. Payload fits in the 128-byte push constant block minus
 * dst/count; callers assert the bound.
 */

#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, buffer_reference_align = 4,
       scalar) buffer u32_ref {
   uint32_t value;
};

layout(push_constant) uniform CONSTS {
   uint64_t dst;
   uint32_t count;
   uint32_t data[28];
};

void
main()
{
   uint32_t i = gl_GlobalInvocationID.x;
   if (i >= count)
      return;

   u32_ref(dst + i * 4).value = data[i];
}
