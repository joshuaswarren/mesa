#version 450
/* control.rounds rounds of the mix function: a loop whose length the
 * compiler cannot bound, so a packet takes at most one of these. */
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer State { uint words[]; };
layout(push_constant) uniform Step { uint from; uint to; uint salt; uint rounds; } control;

void main()
{
    uint lane = gl_GlobalInvocationID.x;
    uint value = words[control.from + lane];
    for (uint r = 0u; r < control.rounds; ++r) {
        value ^= control.salt;
        value = (value ^ (value >> 13u)) * 0x85ebca6bu;
        value = (value ^ (value >> 16u)) * 0xc2b2ae35u;
        value = value ^ (value >> 15u);
    }
    words[control.to + lane] = value;
}
