#version 450
/* Reads a grid of texels; counts those that are not the value the producer
 * wrote before signalling, and keeps one of them. */
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1) buffer Result { uint bad[]; } result;
layout(push_constant) uniform PC { float expected; uint slot; } pc;

void main()
{
   ivec2 size = textureSize(src, 0);
   ivec2 p = ivec2(gl_GlobalInvocationID.xy) * 4;
   if (p.x >= size.x || p.y >= size.y)
      return;
   float v = texelFetch(src, p, 0).r;
   if (v != pc.expected) {
      atomicAdd(result.bad[pc.slot * 2u], 1u);
      result.bad[pc.slot * 2u + 1u] = floatBitsToUint(v);
   }
}
