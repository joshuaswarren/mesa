#version 450
/*
 * Case 2 - data-dependent shift-and-mask feeding a shared-memory scan.
 *
 * mlx-omarchy receipt: 2026-09-02-masked-scatter-m1-fix.md (diag42, diag55,
 * diag68).
 *
 * Computes: an inclusive Hillis-Steele scan of 256 lanes. The scanned bit
 * comes from a constant word 0x00010001 extracted byte-by-byte with a
 * data-dependent shift amount: byte = (word >> ((lane & 3) * 8)) & 0xFF.
 * Lanes 0,2,4,... hold bit 1, so the scan is 1,1,2,2,3,3,... and the last
 * element is 128.
 *
 * Expected: out[lane] = lane / 2 + 1; out[255] == 128.
 * Verified on llvmpipe.
 *
 * Observed on jwm1 (Apple M1, G13G B1, Mesa Honeykrisp, Vulkan API
 * 1.4.357): out[255] == 32, exactly a window-64 scan - the later
 * Hillis-Steele steps stop propagating. The receipt proved the trigger is
 * the dynamic shift itself: the same scan fed by constant per-lane shifts
 * dispatched through an if/else chain, a byte-table select, or a uvec4
 * swizzle produces 128 on the same hardware, and this repro still fails
 * with the shift amount hoisted to a private variable.
 */

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer OutBuf { uint out_scan[]; };

shared uint s_scan[256];

void
main()
{
   uint lane = gl_LocalInvocationID.x;

   uint shamt = (lane & 3u) * 8u;
   uint byte_v = (0x00010001u >> shamt) & 0xFFu;
   uint bit = (byte_v != 0u) ? 1u : 0u;

   s_scan[lane] = bit;
   barrier();

   for (uint d = 1u; d < 256u; d <<= 1u) {
      uint t = 0u;
      if (lane >= d)
         t = s_scan[lane - d];
      barrier();
      if (lane >= d)
         s_scan[lane] += t;
      barrier();
   }

   out_scan[lane] = s_scan[lane];
}
