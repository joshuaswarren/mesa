#version 450
/*
 * Case 1 - SSBO word loads inside a multi-iteration grid-stride loop.
 *
 * mlx-omarchy receipt: 2026-08-31-m1-mlxlm-fp16-smoke.md, "Resolution"
 * section (2026-09-01).
 *
 * Computes: a copy of 200 words by ONE workgroup of 64 threads. Each
 * thread starts at its lane index and strides by 64, so lanes make
 * different numbers of trips (lanes 0-7 make 4, the rest make 3) and
 * the address of the SSBO word load changes every trip. The loop is
 * control-flow divergent across lanes. The original probe also failed
 * with uniform trip counts, so divergence is incidental; the load
 * pattern - a word load hoisted into a loop that changes address each
 * iteration - is the point. The receipt's probe ladder (variants V0/V6,
 * C1) pins the trigger: the same load reads correctly only as one
 * straight-line load per thread at the top of the function, and still
 * fails hoisted inside the loop (variants C1, C3, C4, F5, F6).
 *
 * Expected: out[w] == in[w] for all 200 words. Verified on llvmpipe.
 *
 * Observed on jwm1 (Apple M1, G13G B1, Mesa Honeykrisp, Vulkan API
 * 1.4.354): only words whose byte address is 16-byte aligned read back,
 * that is words with (w & 3) == 0. Every other word reads 0.
 */

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer InBuf  { uint in_words[]; };
layout(set = 0, binding = 1) buffer OutBuf { uint out_words[]; };

void
main()
{
   const uint n = 200u;
   uint g = gl_LocalInvocationID.x;
   for (uint w = g; w < n; w += 64u)
      out_words[w] = in_words[w];
}
